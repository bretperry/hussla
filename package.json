{
  "name": "{{REPO_SLUG}}",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "lint": "oxlint --type-aware --deny-warnings",
    "boundaries": "depcruise src scripts --config .dependency-cruiser.cjs",
    "knip": "knip",
    "rust:fmt": "cargo fmt --all --check",
    "rust:lint": "cargo clippy --workspace --all-targets --locked -- -D warnings",
    "rust:boundaries": "node stacks/rust/boundaries.mjs",
    "rust:test": "cargo nextest run --workspace --locked --status-level fail --final-status-level fail",
    "rust:deny": "cargo deny --locked check bans licenses sources",
    "rust:advisories": "cargo deny --locked check advisories",
    "go:lint": "node stacks/go/run.mjs lint",
    "go:gates": "node stacks/go/gates.mjs",
    "go:test": "node stacks/go/run.mjs test",
    "go:tidy": "node stacks/go/run.mjs tidy",
    "infra:fmt": "node stacks/infra/check.mjs fmt",
    "infra:validate": "node stacks/infra/check.mjs validate",
    "infra:lint": "node stacks/infra/check.mjs lint",
    "infra:docker": "node stacks/infra/check.mjs docker",
    "swift:boundaries": "node stacks/swift/boundaries.mjs",
    "swift:lint": "node stacks/swift/run.mjs lint",
    "swift:gates": "node stacks/swift/gates.mjs",
    "swift:test": "node stacks/swift/run.mjs test",
    "kotlin:check": "node stacks/kotlin/run.mjs check",
    "kotlin:gates": "node stacks/kotlin/gates.mjs",
    "kotlin:device": "node stacks/kotlin/run.mjs device",
    "cpp:build": "node stacks/cpp/run.mjs build",
    "cpp:lint": "node stacks/cpp/run.mjs lint",
    "cpp:test": "node stacks/cpp/run.mjs test",
    "cpp:gates": "node stacks/cpp/gates.mjs",
    "rules:sync": "node scripts/sync-claude-rules.mjs",
    "rules:check": "node scripts/sync-claude-rules.mjs --check",
    "harness:status": "node scripts/harness-sync.mjs status",
    "harness:pull": "node scripts/harness-sync.mjs pull",
    "harness:push": "node scripts/harness-sync.mjs push",
    "harness:eject": "node scripts/harness-eject.mjs",
    "docs:commands": "node scripts/doc-commands.mjs",
    "docs:run": "node scripts/doc-commands.mjs --run",
    "plans:check": "node scripts/plans-status.mjs check",
    "plans:board": "node scripts/plans-status.mjs board --gh --out plan-board.html",
    "models": "node scripts/model-tiers.mjs",
    "overrides": "node scripts/agent-overrides.mjs",
    "rival": "node scripts/rival-review.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:harness": "node --test --test-reporter=dot \"scripts/**/*.test.mjs\" \"stacks/**/*.test.mjs\"",
    "migrations:lint": "node stacks/sql-migrations/lint.mjs",
    "stack:list": "node scripts/stack.mjs list",
    "stack:remove": "node scripts/stack.mjs remove",
    "stack:check": "node scripts/stack.mjs check --packs",
    "stack:drift": "node scripts/stack.mjs drift",
    "py:lint": "python3 stacks/python/run.py lint",
    "py:types": "python3 stacks/python/run.py types",
    "py:boundaries": "python3 stacks/python/run.py boundaries",
    "py:test": "python3 stacks/python/run.py test",
    "py:tooling": "python3 scripts/lib/run_unittests.py scripts/lib",
    "py:selftest": "python3 stacks/python/run.py selftest",
    "check": "node scripts/stack.mjs check",
    "hooks:install": "bash scripts/install-git-hooks.sh"
  },
  "devDependencies": {
    "@swc/core": "1.16.12",
    "@types/node": "24.19.0",
    "dependency-cruiser": "18.4.0",
    "fast-check": "4.10.2",
    "knip": "6.38.0",
    "oxlint": "1.86.0",
    "oxlint-tsgolint": "7.0.2003",
    "squawk-cli": "2.66.0",
    "typescript": "7.0.2",
    "vitest": "5.0.2"
  },
  "pnpm": {
    "ignoredBuiltDependencies": [
      "@swc/core"
    ]
  }
}
