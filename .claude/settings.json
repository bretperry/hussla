{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "outputStyle": "Concise",
  "extraKnownMarketplaces": {
    "openai-codex": { "source": { "source": "github", "repo": "openai/codex-plugin-cc" } }
  },
  "enabledPlugins": {
    "typescript-lsp@claude-plugins-official": true,
    "gopls-lsp@claude-plugins-official": true,
    "codex@openai-codex": true
  },
  "permissions": {
    "allow": [
      "Bash(pnpm typecheck)",
      "Bash(pnpm lint)",
      "Bash(pnpm lint *)",
      "Bash(pnpm boundaries)",
      "Bash(pnpm knip)",
      "Bash(pnpm test)",
      "Bash(pnpm test *)",
      "Bash(pnpm check)",
      "Bash(pnpm test:harness)",
      "Bash(pnpm stack:list)",
      "Bash(pnpm harness:status)",
      "Bash(pnpm exec vitest *)",
      "Bash(pnpm exec depcruise *)",
      "Bash(pnpm go:lint)",
      "Bash(pnpm go:gates)",
      "Bash(pnpm go:test)",
      "Bash(pnpm go:tidy)",
      "Bash(go test *)",
      "Bash(go vet *)",
      "Bash(golangci-lint run *)",
      "Bash(pnpm infra:fmt)",
      "Bash(pnpm infra:validate)",
      "Bash(pnpm infra:lint)",
      "Bash(pnpm infra:docker)",
      "Bash(terraform fmt *)",
      "Bash(terraform validate *)",
      "Bash(tflint *)",
      "Bash(hadolint *)",
      "Bash(gh pr list *)",
      "Bash(gh pr view *)",
      "Bash(gh pr diff *)",
      "Bash(gh pr checks *)",
      "Bash(gh run list *)",
      "Bash(gh run view *)",
      "Bash(pnpm models)",
      "Bash(pnpm models *)",
      "Bash(pnpm rival doctor)",
      "Bash(pnpm rival scope)",
      "Bash(pnpm rival review *)",
      "Bash(pnpm rival chat *)"
    ],
    "deny": [
      "Read(./.env)",
      "Read(./.env.local)",
      "Read(./.env.*.local)",
      "Read(./.env.production)",
      "Read(./secrets/**)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          { "type": "command", "command": "node \"$CLAUDE_PROJECT_DIR/scripts/command-guard-hook.mjs\" claude || exit 2", "timeout": 10 }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          { "type": "command", "command": "node \"$CLAUDE_PROJECT_DIR/scripts/check-edited.mjs\" claude", "timeout": 90 }
        ]
      }
    ]
  }
}
