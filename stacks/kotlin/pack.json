  "checks": [
    {
      "name": "Kotlin build, lint, format, layers, and tests (gradle check)",
      "script": "kotlin:check"
    },
    {
      "name": "Kotlin gates still bite",
      "script": "kotlin:gates"
    }
  ],
  "editCheck": {
    "extensions": [
      ".kt",
      ".kts",
      ".toml"
    ],
    "run": "stacks/kotlin/check-edited.mjs"
  },
  "ejectRemove": [
    "stacks/kotlin/check-edited.mjs"
  ],
  "ciHeavy": [
    "^(settings|build)\\.gradle\\.kts$",
    "^gradle\\.properties$",
    "^gradle/"
  ],
  "generated": [],
  "packageJson": {
    "scripts": [
      "kotlin:check",
      "kotlin:gates",
      "kotlin:device"
    ]
  },
  "claudeSettings": {
    "allow": [
      "Bash(pnpm kotlin:check)",
      "Bash(pnpm kotlin:gates)",
      "Bash(pnpm kotlin:device)",
      "Bash(./gradlew check)",
      "Bash(./gradlew ktfmtFormat)",
      "Bash(./gradlew :*:test --tests *)"
    ],
    "plugins": []
  }
