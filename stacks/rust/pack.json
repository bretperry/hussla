{
  "name": "rust",
  "kind": "language",
  "summary": "Rust 2024 workspace (domain / app / adapters crates), clippy pedantic + deny list, rustfmt, cargo-deny, layer-map boundary check, nextest + proptest.",
  "requires": [],
  "adoptOn": [
    ".cursor/rules/rust.mdc"
  ],
  "docs": [
    ".cursor/rules/rust.mdc",
    ".cursor/rules/testing-rust.mdc"
  ],
  "code": [
    "stacks/rust/check-edited.mjs",
    "stacks/rust/boundaries.mjs",
    "stacks/rust/boundaries.test.mjs",
    "stacks/rust/chaos-feature.test.mjs",
    "stacks/rust/ci-heavy.test.mjs",
    "stacks/rust/check-edited.test.mjs",
    "rustfmt.toml",
    "clippy.toml"
  ],
  "owns": [
    "rust-toolchain.toml",
    "Cargo.toml",
    "Cargo.lock",
    "deny.toml",
    "crates/domain/Cargo.toml",
    "crates/domain/src/lib.rs",
    "crates/domain/src/config.rs",
    "crates/domain/src/note.rs",
    "crates/app/Cargo.toml",
    "crates/app/src/lib.rs",
    "crates/app/src/config.rs",
    "crates/app/src/ports.rs",
    "crates/app/src/note_sync.rs",
    "crates/adapters/Cargo.toml",
    "crates/adapters/src/lib.rs",
    "crates/adapters/src/chaos/mod.rs",
    "crates/adapters/src/chaos/clock.rs",
    "crates/adapters/src/chaos/fault_server.rs",
    "crates/adapters/src/chaos/memory_outbox.rs",
    "crates/adapters/tests/note_sync_chaos.rs",
    "crates/domain/proptest-regressions/note.txt",
    "crates/adapters/tests/note_sync_chaos.proptest-regressions"
  ],
  "checks": [
    {
      "name": "Rust format",
      "script": "rust:fmt"
    },
    {
      "name": "Rust lint",
      "script": "rust:lint"
    },
    {
      "name": "Rust boundaries",
      "script": "rust:boundaries"
    },
    {
      "name": "Rust tests",
      "script": "rust:test"
    },
    {
      "name": "Rust dependency audit",
      "script": "rust:deny"
    }
  ],
  "editCheck": {
    "extensions": [
      ".rs",
      ".toml"
    ],
    "run": "stacks/rust/check-edited.mjs"
  },
  "ejectRemove": [
    "stacks/rust/check-edited.mjs",
    "stacks/rust/check-edited.test.mjs"
  ],
  "ciHeavy": [
    "^Cargo\\.(toml|lock)$",
    "^rust-toolchain\\.toml$",
    "^crates/"
  ],
  "generated": [],
  "packageJson": {
    "scripts": [
      "rust:fmt",
      "rust:lint",
      "rust:boundaries",
      "rust:test",
      "rust:deny",
      "rust:advisories"
    ],
    "devDependencies": []
  },
  "claudeSettings": {
    "allow": [
      "Bash(pnpm rust:fmt)",
      "Bash(pnpm rust:lint)",
      "Bash(pnpm rust:boundaries)",
      "Bash(pnpm rust:test)",
      "Bash(pnpm rust:deny)",
      "Bash(cargo fmt *)",
      "Bash(cargo clippy *)",
      "Bash(cargo check *)",
      "Bash(cargo nextest run *)",
      "Bash(pnpm rust:advisories)"
    ],
    "plugins": []
  }
}
