{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "entry": [
    "scripts/*.{mjs,ts}"
  ],
  "project": [
    "src/**/*.{ts,tsx}",
    "scripts/**/*.{mjs,ts}",
    "src/test/*.mjs"
  ],
  "ignoreDependencies": [
    "@swc/core",
    "tailwindcss"
  ],
  "ignoreBinaries": [
    "mkfifo"
  ],
  "ignore": [
    "src/shared/api-types.ts"
  ]
}
